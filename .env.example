# Gleea serverless proxy configuration.
#
# Copy this file to `.env.local` (which is git-ignored) and fill in your key.
# The Anthropic API key is read ONLY on the server (the /api/generate-story
# route handler). It is never exposed to the browser. Do NOT prefix it with
# NEXT_PUBLIC_.

# Required for live AI personalization. Without it, the app still runs and uses
# a local, age-appropriate fallback story (the demo never dead-ends).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5 (fast + low-cost for a demo).
# Other current options: claude-sonnet-4-6, claude-opus-4-8.
ANTHROPIC_MODEL=claude-haiku-4-5
